{
  "CONFIG_KIND": "EXECUTABLE_STAGE2_CONFIGURATION",
  "base_release_config": "config/release_2026Q1.json",
  "output_id": "2026Q1_v2",
  "historical_vintage_id": "historical_2026Q1",
  "historical_vintage_label": "current-vintage historical series",
  "phase0_tolerances": {
    "amount_oku_yen": 0.01,
    "percentage_point": 0.01,
    "margin_percentage_point": 0.005
  },
  "pattern_rule": {
    "persistent_min_same_direction_last4": 3,
    "recent_same_direction_last4": 2,
    "outlier_percentile_threshold": 90.0,
    "criteria_frozen_before_analysis": true
  },
  "candidate_rules": {
    "A": {
      "label_ja": "資本金十億円以上の製造業への経常増益集中",
      "indicator": "large_manufacturing_ordinary_contribution_pct",
      "positive_threshold": 50.0,
      "threshold_unit": "percent"
    },
    "B": {
      "label_ja": "小規模売上増と営業利益率低下・大規模利益率上昇",
      "indicator": "capital_margin_divergence_composite",
      "positive_threshold": 0.0,
      "required_conditions": [
        "small_sales_yoy_pct > 0",
        "small_operating_margin_delta_pp < 0",
        "large_operating_margin_delta_pp > 0"
      ]
    },
    "C": {
      "label_ja": "設備投資横ばい・ソフトウェア増・ソフト除く投資減",
      "indicator": "software_rotation_composite",
      "positive_threshold": 0.0,
      "flat_including_capex_abs_yoy_pct_max": 1.0,
      "required_conditions": [
        "abs(capex_including_yoy_pct) <= 1.0",
        "software_capex_yoy_delta_oku_yen > 0",
        "capex_excluding_yoy_delta_oku_yen < 0"
      ]
    },
    "D": {
      "label_ja": "経常利益増加に占める営業利益外差額の改善",
      "indicator": "net_non_operating_gap_share_pct",
      "positive_threshold": 25.0,
      "threshold_unit": "percent"
    },
    "E": {
      "label_ja": "情報通信機械器具製造業の経常増益寄与",
      "indicator": "ict_machinery_ordinary_contribution_pct",
      "positive_threshold": 25.0,
      "threshold_unit": "percent"
    }
  },
  "taxonomy_policy": {
    "major_source": "src/corporate_quarterly/constants.py::MAJOR_INDUSTRY_NAMES",
    "leaf_industry_codes": [
      "109", "110", "112", "113", "114", "115", "116", "117", "118", "119",
      "120", "154", "121", "124", "122", "145", "123", "125", "126", "101",
      "103", "106", "107", "135", "136", "142", "131", "132", "133", "127",
      "128", "130", "150", "151", "139", "148", "140", "141", "138", "158",
      "159", "153", "152", "160", "143"
    ],
    "excluded_overlapping_or_legacy_codes": [
      "104", "108", "163", "111", "146", "144", "105", "162", "102", "134",
      "129", "155", "149", "137", "156", "157", "161"
    ]
  }
}
